{
  "name": "liva-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/liva-common",
    "liva-ui",
    "liva-desktop",
    "teamwork_projects/obsidian_llm_wiki",
    "mobile_client"
  ],
  "scripts": {
    "setup": "npm install && npm run build:ui",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start_all.ps1",
    "build:ui": "npm run build -w liva-ui",
    "build:desktop": "npm run build:ui && npm run build -w liva-desktop",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:map": "node scripts/docs-check.mjs --map",
    "prepare": "husky"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "gitnexus": "^1.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.59.4"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
