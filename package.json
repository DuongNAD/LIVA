{
  "name": "liva-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/liva-common",
    "liva-ui",
    "liva-desktop",
    "teamwork_projects/obsidian_llm_wiki",
    "mobile_client"
  ],
  "scripts": {
    "setup": "npm install && npm run build:ui",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start_all.ps1",
    "build:ui": "npm run build -w liva-ui",
    "build:desktop": "npm run build:ui && npm run build -w liva-desktop",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:map": "node scripts/docs-check.mjs --map",
    "gitnexus:index": "node .gitnexus/run.cjs analyze --force --pdg --embeddings",
    "prepare": "husky"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.10.0",
    "gitnexus": "1.6.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.59.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.32.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "esbuild": "0.28.1",
    "gh-pages": "6.3.0"
  }
}
