# ═══════════════════════════════════════════════════
#  LIVA System — Environment Configuration (EXAMPLE)
#  Created: 2026-05-07 | Mode: LOCAL (GGUF Native)
# ═══════════════════════════════════════════════════

# ─── AI Provider Mode ───────────────────────────────
# "local" = Local GGUF via llama-server / Native Engine (gRPC)
# "cloud" = Cloud API (OpenAI/Gemini compatible)
AI_PROVIDER=local

# ─── Local Model Config ─────────────────────────────
AI_MODELS_DIR=E:\AI_Models
ROUTER_MODEL_NAME=gemma-4-E4B-it-Q4_K_M.gguf
EXPERT_MODEL_NAME=gemma-4-E4B-it-Q4_K_M.gguf

# ─── Native gRPC Engine ─────────────────────────────
# "true" = Use NativeIPCClient (gRPC port 8100, zero HTTP overhead)
# "false" = Use OpenAI HTTP client (port 8000, legacy)
LIVA_USE_NATIVE=true

# Native engine tuning
NATIVE_N_CTX=8192
NATIVE_N_GPU_LAYERS=-1
NATIVE_TEMPERATURE=0.7
NATIVE_N_BATCH=2048
NATIVE_N_THREADS=4

# ─── Cloud API Config (for future use) ──────────────
# Uncomment and fill when switching to AI_PROVIDER=cloud
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-api-key-here
# AI_MODEL=gemini-2.5-flash

# ─── Security ───────────────────────────────────────
# 32-byte AES-256 key for EncryptionEngine (auto-generated)
LIVA_ENCRYPTION_KEY=your-32-byte-secure-key-here!

# ─── Email (IMAP) ──────────────────────────────────
# Dùng cho skill: read_emails, check_important_emails_today, send_email
# ⚠️ Gmail yêu cầu App Password (KHÔNG phải mật khẩu thường)
#    Tạo tại: https://myaccount.google.com/apppasswords
# EMAIL_HOST đã được chuyển vào liva_vault.json (Mã hóa bởi electron.safeStorage)
# EMAIL_HOST đã được chuyển vào liva_vault.json (Mã hóa bởi EncryptionEngine)
EMAIL_PORT=993
# EMAIL_USER đã được chuyển vào liva_vault.json (Mã hóa bởi electron.safeStorage)
# EMAIL_USER đã được chuyển vào liva_vault.json (Mã hóa bởi EncryptionEngine)
# EMAIL_PASS đã được chuyển vào liva_vault.json (Mã hóa bởi electron.safeStorage)
# EMAIL_PASS đã được chuyển vào liva_vault.json (Mã hóa bởi EncryptionEngine)

# ─── Google API (OAuth2) ────────────────────────────
# Dùng cho skill: Google Docs, Sheets, Drive
# File credentials.json phải đặt tại thư mục gốc liva-gateway/
GOOGLE_CLIENT_SECRET=

# ─── System Flags ───────────────────────────────────
LIVA_GEOLOCATION_ENABLED=true

# ─── STT (Whisper) Routing ──────────────────────────
# Priority 1: Explicit override (highest)
# Default: Python Native Engine on port 8100 (LLM inference only)
WHISPER_URL=http://127.0.0.1:8101/v1/audio/transcriptions
WHISPER_MODEL=small

# Priority 2: Cloud fallback (use when AI_PROVIDER=local to save GPU VRAM)
# Uncomment and set API key in AI_API_KEY for cloud STT
# WHISPER_CLOUD_URL=https://api.groq.com/openai/v1/audio/transcriptions

# ─── News / Shadow Digest ──────────────────────────
# Required for news_briefing route (ProactiveDaemon)
# Get free API key at: https://tavily.com
# TAVILY_API_KEY đã được chuyển vào liva_vault.json (Mã hóa bởi electron.safeStorage)

# ─── Zalo OA ──────────────────────────────────────
# Dùng cho skill: send_zalo_message
ZALO_APP_ID=
ZALO_APP_SECRET=
# ZALO_OA_ACCESS_TOKEN đã được chuyển vào liva_vault.json (Mã hóa bởi electron.safeStorage)
ZALO_OA_ACCESS_TOKEN=your-zalo-oa-token-here
ZALO_USER_ID=your-zalo-user-id-here

# --- Remote Control Hub -------------------------------
REMOTE_CONTROL_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=

# --- Weather API --------------------------------------
WEATHER_API_KEY=your-weather-api-key-here
