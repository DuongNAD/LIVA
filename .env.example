# ═══════════════════════════════════════════════════
#  LIVA System — Unified Environment Configuration Template
#  Workspace Level | Version: v30.0 (2026-07 overhaul)
#  Nguồn sự thật: các biến LIVA_* được đọc trong
#  liva-native-core/src/main.rs + lib.rs (Rust core).
# ═══════════════════════════════════════════════════

# ─── 1. Security & Encryption (BẮT BUỘC) ────────────
# 32-byte AES-256 key for the central EncryptionEngine
LIVA_ENCRYPTION_KEY=your-32-byte-encryption-key-here
# Tauri Stronghold vault (desktop shell)
LIVA_STRONGHOLD_PASSWORD=
LIVA_STRONGHOLD_SALT=

# ─── 2. Core Server ─────────────────────────────────
LIVA_SERVER_HOST=127.0.0.1
LIVA_SERVER_PORT=8002
# Tokio runtime tuning (để trống = mặc định theo CPU)
LIVA_TOKIO_WORKER_THREADS=
LIVA_TOKIO_MAX_BLOCKING_THREADS=

# ─── 3. Database ────────────────────────────────────
LIVA_DB_PATH=
LIVA_DB_IN_MEMORY=false

# ─── 4. LLM (local GGUF qua llama.cpp) ──────────────
# Thư mục chứa model *.gguf (tải out-of-band, đã gitignore)
LIVA_LLM_MODEL_DIR=E:\AI_Models
LIVA_LLM_N_CTX=4096
# 0 = CPU; -1 = toàn bộ layer lên GPU (máy có RTX thì nên -1,
# game-mode governor sẽ tự hạ khi GPU bận)
LIVA_LLM_N_GPU_LAYERS=-1
LIVA_LLM_THREADS=

# ─── 5. Voice — STT / TTS ───────────────────────────
# Nemotron ASR (multilingual; lang_id kiểm chứng: vi=33, en=0 — xem stt/lang.rs)
LIVA_STT_MODEL_DIR=models/nemotron-asr
# Ngôn ngữ nhận dạng mặc định (vi | en); đổi runtime: lệnh voice:set_language
LIVA_STT_LANGUAGE=vi
# TTS local-first: Piper VITS ONNX (vi_VN + en_US, tải về models/piper/)
LIVA_TTS_PIPER_DIR=models/piper
LIVA_TTS_LANGUAGE=vi
# Kokoro (fallback EN premium — cần tự tải model, mặc định KHÔNG có trên đĩa)
LIVA_TTS_MODEL_PATH=models/kokoro-v1.0.onnx
LIVA_TTS_VOICE_PATH=node_modules/kokoro-js/voices/af_heart.bin
# espeak-ng: để trống = tự tìm (PATH → Program Files); chỉ định nếu cài chỗ khác
LIVA_ESPEAK_PATH=

# ─── 5b. VAD / Wake word / Game mode ────────────────
# Model Silero VAD: để trống = tự tìm models/silero_vad_v6.onnx (v6.2, chống ồn
# tốt hơn ~16% khi chơi game) rồi fallback silero_vad.onnx trong LIVA_STT_MODEL_DIR
LIVA_VAD_MODEL_PATH=
# VAD Silero: end-of-turn 22 frame ≈ 0.7s (mặc định cũ 45 ≈ 1.44s quá chậm)
LIVA_VAD_THRESHOLD=0.5
LIVA_VAD_START_FRAMES=3
LIVA_VAD_END_FRAMES=22
# Wake word "LIVA" (off | asr_prefix | trained_model | hybrid):
# - asr_prefix: luôn lắng nghe, chỉ chuyển tiếp câu nói bắt đầu bằng tên LIVA
# - trained_model: classifier ONNX huấn luyện riêng (xem wake_model.rs), quét âm thanh liên tục
# - hybrid (KHUYẾN NGHỊ song ngữ): 2 tầng OR — classifier (tầng 1, mạnh tiếng Anh)
#   HOẶC STT khớp "liva" (tầng 2, đáng tin tiếng Việt). Cái nào bắt được cũng mở,
#   bù trừ điểm yếu cho nhau. Cần LIVA_WAKE_MODEL_PATHS (dùng tầng 1); thiếu = STT-only.
LIVA_WAKE_MODE=off
# Danh sách khớp: gồm cả cách STT tiếng Việt hay nghe nhầm tên "liva" (đã bỏ dấu
# + ghép chữ khi so, nên "li vào" → "livao" tự khớp "liva"). Thêm nếu giọng bạn lệch khác.
LIVA_WAKE_PHRASES=liva,hey liva,ê liva,này liva,liva ơi,laiva,leva,lyva,li goa
LIVA_WAKE_WINDOW_SECS=45
# trained_model: CSV đường dẫn classifier .onnx (1 file/giọng — khớp bất kỳ
# file nào cũng mở gate). Model giọng Anh đã train xong (2026-07-04):
# models/wake_liva_en.onnx, eval 17.85h: recall 98.8%/FPPH 1.74 @0.5,
# ngưỡng TỐI ƯU theo eval là 0.77 (recall 98.15%/FPPH 0.168) — nên dùng 0.77.
# VD bật thử: LIVA_WAKE_MODEL_PATHS=models/wake_liva_en.onnx
LIVA_WAKE_MODEL_PATHS=
LIVA_WAKE_THRESHOLD=0.77
# Model mel-spectrogram/embedding dùng chung (bundle Apache-2.0 từ
# livekit-wakeword) — để trống = tự tìm models/wakeword_{melspec,embedding}.onnx
LIVA_WAKE_MELSPEC_PATH=
LIVA_WAKE_EMBEDDING_PATH=
# Game mode (auto | on | off): auto = phát hiện app fullscreen,
# hạ priority tiến trình để không giật game
LIVA_GAME_MODE=auto
LIVA_GAME_PRIORITY=on

# ─── 5c. Mic pre-processing / turn-taking (nghiên cứu 2026-07-04) ──
# Tất cả mặc định TẮT — bật thử nghiệm từng cái, đo trước khi để mặc định on.
# Xem docs/reports/LIVA_OSS_Research_2026-07.md để biết chi tiết + license.
# GTCRN denoise (models/gtcrn_simple.onnx, MIT) chạy trước VAD/STT.
LIVA_DENOISE_ENABLED=0
LIVA_DENOISE_MODEL_PATH=
# Smart Turn v3.2 (models/smart_turn_v3.2_cpu.onnx, BSD-2) — SHADOW MODE: chỉ
# log xác suất kết thúc lượt nói để so sánh, KHÔNG thay quyết định VAD hiện có
# (tiếng Việt là ngôn ngữ yếu nhất của model này, ~81% so với ~94% tiếng Anh).
LIVA_TURN_SHADOW_ENABLED=0
LIVA_TURN_MODEL_PATH=
# Sonora AEC3 (pure-Rust, BSD-3) — khử tiếng LIVA tự nói vọng lại mic khi
# barge-in (chưa xử lý được tiếng game qua loa, chỉ tiếng TTS của chính LIVA).
LIVA_AEC_ENABLED=0

# ─── 6. Obsidian Vault (MCP knowledge base) ─────────
LIVA_VAULT_PATH=E:\Project\LIVA\teamwork_projects\obsidian_llm_wiki\vault

# ─── 7. AI Provider Mode (Dashboard-managed) ────────
# "local" = GGUF native engine | "cloud" = OpenAI/Gemini-compatible API
# (ApiManagementView.vue đọc/ghi các biến mục 7-9)
AI_PROVIDER=local
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-2.5-flash

# ─── 8. Social & Messaging Integrations ─────────────
# Remote Control Hub (Telegram bot — core đọc BOT_TOKEN + ALLOWED_IDS)
REMOTE_CONTROL_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=
# Zalo OA
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_USER_ID=

# ─── 9. Email Client (IMAP) ─────────────────────────
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASS=
