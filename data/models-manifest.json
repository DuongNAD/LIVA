      "note": "Bật mặc định; tắt bằng LIVA_DENOISE_ENABLED=0."
    },
    "turn-shadow": {
      "name": "End-of-turn ngữ nghĩa (shadow)",
      "required": false,
      "broken": "Không có gì hỏng — tính năng này tắt mặc định.",
      "note": "Bật bằng LIVA_TURN_SHADOW_ENABLED=1."
    },
    "wake": {
      "name": "Wake-word (\"hey LIVA\")",
      "required": false,
      "broken": "LIVA_WAKE_MODE=trained_model sẽ không chạy. Chế độ asr_prefix vẫn dùng được.",
      "note": "Với tiếng Việt nên dùng LIVA_WAKE_MODE=asr_prefix — model vi tự train FPPH 19,4, chưa đủ tốt."
    },
    "stt-vi-hq": {
