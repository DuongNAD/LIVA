# ═══════════════════════════════════════════════════
#  LIVA System — Unified Environment Configuration Template
#  Workspace Level | Version: v30.0 (2026-07 overhaul)
#  Nguồn sự thật: các biến được đọc trong Rust core (`boot.rs`,
#  `memory_retention.rs`, `websocket.rs`, `wake.rs`, `webrtc/*`, `tts/*`...).
# ═══════════════════════════════════════════════════

# ─── 1. Security & Encryption ───────────────────────
# Khoá mã hoá facts (HKDF-SHA256 từ passphrase này). TUỲ CHỌN từ 22/07/2026:
# nếu KHÔNG đặt (hoặc đặt = "0"×32), LIVA tự sinh khoá thiết bị 32 byte niêm
# phong bằng Windows DPAPI (lưu .device_key cạnh DB) và IN KHOÁ 1 LẦN lúc boot
# đầu — HÃY SAO LƯU dòng đó. Đặt biến này (= khoá đã backup) để KHÔI PHỤC khi
# cài lại Windows, hoặc để cố định khoá trên CI/nhiều máy. KHÔNG dùng "0"×32
# làm khoá thật (công khai, chỉ dùng cho test/in-memory).
LIVA_ENCRYPTION_KEY=
# Khi XOAY khoá: đặt khoá CŨ vào đây, boot sẽ tự giải bằng khoá cũ rồi mã lại
# bằng khoá mới (LIVA_ENCRYPTION_KEY), không mất facts. Gỡ ra sau khi rekey xong.
LIVA_ENCRYPTION_KEY_OLD=
# Tauri Stronghold vault (desktop shell) — kho API key. TUỲ CHỌN từ 23/07/2026:
# nếu KHÔNG đặt, vault dùng bí mật per-machine tự sinh niêm phong DPAPI
# (.vault_secret cạnh snapshot). Đặt PASSWORD để cố định/đồng bộ vault giữa máy;
# SALT bỏ trống thì dùng nhãn cố định mặc định. Vault chứa API key nhập lại được
# nên KHÔNG escrow (khác LIVA_ENCRYPTION_KEY của facts).
LIVA_STRONGHOLD_PASSWORD=
LIVA_STRONGHOLD_SALT=

# ─── 2. Core Server ─────────────────────────────────
LIVA_SERVER_HOST=127.0.0.1
# Origin được phép nối vào WebSocket gateway, ngăn cách bằng dấu phẩy.
# Mặc định đã cho phép: http://localhost:5173, http://127.0.0.1:5173,
# tauri://localhost, https://tauri.localhost — đủ cho liva-ui dev và vỏ Tauri.
# WebSocket KHÔNG chịu Same-Origin Policy, nên nếu bỏ hàng rào này thì bất kỳ
# trang web nào người dùng mở cũng nối được vào core. Chỉ thêm origin bạn tin.
LIVA_WS_ALLOWED_ORIGINS=
LIVA_SERVER_PORT=8002
# Bề mặt HTTP tương thích OpenAI (/v1/models, /v1/chat/completions,
# /v1/audio/speech) — để công cụ sẵn có gọi LIVA mà không cần biết giao thức
# riêng ở cổng trên. ĐỂ TRỐNG = TẮT, không mở socket nào.
# Cố ý không bật mặc định: nó KHÔNG có xác thực, y như cổng 8002. Bind theo
# LIVA_SERVER_HOST ở trên; đừng trỏ ra ngoài 127.0.0.1 khi chưa có TLS + token.
LIVA_OPENAI_PORT=
# Tokio runtime tuning (để trống = mặc định theo CPU)
LIVA_TOKIO_WORKER_THREADS=
LIVA_TOKIO_MAX_BLOCKING_THREADS=

# ─── 3. Database ────────────────────────────────────
LIVA_DB_PATH=
LIVA_DB_IN_MEMORY=false
# Retention conversation memory mặc định TẮT để không tự xóa dữ liệu.
# Đặt số ngày > 0 để bật sweeper nền. Worker xóa theo hoạt động MỚI NHẤT của
# hội thoại, batch nhỏ, audit từng hội thoại và retry ở nhịp sau nếu bị gián đoạn.
LIVA_MEMORY_RETENTION_DAYS=0
LIVA_MEMORY_RETENTION_INTERVAL_SECS=3600
LIVA_MEMORY_RETENTION_BATCH_SIZE=10

# ─── 4. LLM (local GGUF qua llama.cpp) ──────────────
# ⚠️ [KHÔNG CÓ TÁC DỤNG Ở RUNTIME] — biến này chỉ được đọc bởi một binary
# stress test (src/bin/router_stress.rs). Ứng dụng thật lấy thư mục model từ
# data/liva-config.json → ai.localModelsDir (mặc định E:\AI_Models) và tên
# model từ ai.routerModel. Sửa ở đó, hoặc qua màn hình Settings.
LIVA_LLM_MODEL_DIR=E:\AI_Models
LIVA_LLM_N_CTX=4096

# ─── 4b. Model embedding cho bộ nhớ dài hạn ─────────
# TÁCH KHỎI model chat có chủ đích. Lý do: bảng vec_idx khai cứng int8[384],
# còn embedding của model chat phụ thuộc model đang nạp (Qwen3-VL-2B cho 2048
# chiều) — ghi vào sẽ lỗi "Dimension mismatch". Quan trọng hơn: dùng model chat
# nghĩa là đổi model chat là toàn bộ bộ nhớ cũ thành vô nghĩa.
# Cần 2 file trong thư mục: model.onnx + tokenizer.json, output 384 chiều.
# Khuyến nghị: intfloat/multilingual-e5-small (hỗ trợ tiếng Việt).
# THIẾU model thì bộ nhớ dài hạn không ghi/tìm được; phần còn lại vẫn chạy.
LIVA_EMBEDDING_MODEL_DIR=models/embedding
# Số luồng CPU cho ONNX session của embedder (mặc định 1)
LIVA_EMBEDDING_THREADS=1
# So ky uc lay ra moi luot chat (RAG). Giu nho co chu y: moi ky uc chen them
# token vao prompt, ma LIVA_LLM_N_CTX mac dinh chi 4096. Ngoai khoang 1-20 hoac
# khong parse duoc -> dung mac dinh 3.
LIVA_RAG_TOP_K=3
# Số tin nhắn tối đa giữ lại trong lịch sử hội thoại, KHÔNG kể tin `system`.
# 20 ≈ 10 lượt hỏi–đáp. Đây là chốt chặn để prompt không phình vượt
# LIVA_LLM_N_CTX sau nhiều lượt nói (xem trim_history trong webrtc/pipeline.rs).
# Giá trị 0 hoặc không parse được → dùng mặc định 20.
LIVA_MAX_HISTORY_MESSAGES=20
# Số layer LLM offload lên GPU. 0 = CPU; 99 = toàn bộ (llama.cpp tự kẹp về số
# layer thật). Đây là u32 — KHÔNG dùng -1 (parse fail → 0/CPU).
# CHỈ có tác dụng khi build core với CUDA: `cargo build --release --features cuda`
# (RTX cần CUDA toolkit; card Blackwell/5060 Ti cần CUDA 12.8+). Trên build
# CPU-thuần, giá trị này bị bỏ qua (không có backend GPU). mmproj/clip (vision)
# tự chạy GPU khi n_gpu_layers>0. GPU đọc màn hình nhanh hơn CPU rất nhiều.
# Máy 16GB VRAM: 2B ~1.5-2GB, chạy chung game OK.
LIVA_LLM_N_GPU_LAYERS=99
# Game-aware GPU downshift: khi phát hiện game fullscreen (LIVA_GAME_MODE), tự
# reload LLM với ngần này layer để trả VRAM cho game; thoát game thì khôi phục
# LIVA_LLM_N_GPU_LAYERS. Mặc định 0 = chạy hẳn CPU khi đang chơi game (nhường
# toàn bộ VRAM). Đặt = LIVA_LLM_N_GPU_LAYERS để TẮT tính năng (không reload).
# Chỉ có tác dụng trên build CUDA và khi normal>0. Reload tốn ~vài giây + reset
# KV cache, chỉ chạy đúng lúc CHUYỂN trạng thái game (vào/ra), không lặp lại.
LIVA_GAME_N_GPU_LAYERS=0
LIVA_LLM_THREADS=

# ─── 5. Voice — STT / TTS ───────────────────────────
# Nemotron ASR (multilingual; lang_id kiểm chứng: vi=33, en=0 — xem stt/lang.rs)
LIVA_STT_MODEL_DIR=models/nemotron-asr
# Ngôn ngữ nhận dạng mặc định (vi | en); đổi runtime: lệnh voice:set_language
LIVA_STT_LANGUAGE=vi
# Engine STT tiếng Việt: parakeet (mặc định) | nemotron (opt-out, streaming).
# Parakeet-CTC 0.6B offline, WER FLEURS vi 12,00% vs 15,01% — tốt hơn 1,25×,
# dùng cho transcribe cả câu sau VAD-end; không có partial streaming. Tải bằng
# `npm run setup:models -- --profile full`; thiếu model thì tự lùi về Nemotron.
LIVA_STT_VI_ENGINE=parakeet
# Override đường dẫn model Parakeet (để trống = models/parakeet_vi.onnx; vocab
# suy ra parakeet_vi_vocab.json cùng thư mục, hoặc đặt LIVA_PARAKEET_VOCAB_PATH)
LIVA_PARAKEET_MODEL_PATH=
LIVA_PARAKEET_VOCAB_PATH=
# Số intra-op thread cho Parakeet (mặc định 4). Hạ xuống nếu chạy chung tải nặng
# (game/render) — governor cũng tự hạ priority tiến trình khi vào game-mode.
LIVA_PARAKEET_THREADS=4
# TTS local-first: Piper VITS ONNX (vi_VN + en_US, tải về models/piper/)
LIVA_TTS_PIPER_DIR=models/piper
LIVA_TTS_LANGUAGE=vi
# Kokoro (fallback EN premium — cần tự tải model, mặc định KHÔNG có trên đĩa)
LIVA_TTS_MODEL_PATH=models/kokoro-v1.0.onnx
LIVA_TTS_VOICE_PATH=node_modules/kokoro-js/voices/af_heart.bin
# espeak-ng: để trống = tự tìm (PATH → Program Files); chỉ định nếu cài chỗ khác
LIVA_ESPEAK_PATH=

# VieNeu-TTS — giọng neural tiếng Việt, port thuần Rust. OPT-IN, mặc định tắt.
# Bật bằng 1/true/yes/on. Khi bật, VieNeu được ưu tiên trước Piper cho tiếng Việt.
LIVA_TTS_VIENEU=0
# Thư mục chứa model VieNeu (mặc định models/vieneu)
LIVA_VIENEU_MODEL_DIR=models/vieneu
# Tên giọng; để trống = dùng default_voice khai trong file model
LIVA_VIENEU_VOICE=
# Số luồng CPU cho ONNX; để trống = mặc định của runtime
LIVA_VIENEU_THREADS=
# Seed cho phần ngẫu nhiên; đặt cố định để tái lập được kết quả khi debug
LIVA_VIENEU_SEED=

# ─── 5b. VAD / Wake word / Game mode ────────────────
# Model Silero VAD: để trống = tự tìm models/silero_vad_v6.onnx (v6.2, chống ồn
# tốt hơn ~16% khi chơi game) rồi fallback silero_vad.onnx trong LIVA_STT_MODEL_DIR
LIVA_VAD_MODEL_PATH=
# VAD Silero: end-of-turn 22 frame ≈ 0.7s (mặc định cũ 45 ≈ 1.44s quá chậm)
LIVA_VAD_THRESHOLD=0.5
LIVA_VAD_START_FRAMES=3
LIVA_VAD_END_FRAMES=22
# Wake word "LIVA" (off | asr_prefix | trained_model | hybrid):
# - asr_prefix: luôn lắng nghe, chỉ chuyển tiếp câu nói bắt đầu bằng tên LIVA
# - trained_model: classifier ONNX huấn luyện riêng (xem wake_model.rs), quét âm thanh liên tục
# - hybrid (KHUYẾN NGHỊ song ngữ): 2 tầng OR — classifier (tầng 1, mạnh tiếng Anh)
#   HOẶC STT khớp "hey liva" (tầng 2, đáng tin tiếng Việt). Cái nào bắt được cũng mở,
#   bù trừ điểm yếu cho nhau. Cần LIVA_WAKE_MODEL_PATHS (dùng tầng 1); thiếu = STT-only.
LIVA_WAKE_MODE=off
# Câu gọi duy nhất được phát hành. Chỉ ghi đè khi thử nghiệm có chủ đích.
LIVA_WAKE_PHRASES=hey liva
LIVA_WAKE_WINDOW_SECS=45
# trained_model: CSV đường dẫn classifier .onnx (1 file/giọng — khớp bất kỳ
# file nào cũng mở gate). Để trống = core tự tìm model v2 đã kiểm hash:
# models/wake_liva_en_v2.onnx. Bản owner-calibrated 2026-08-05 tại threshold 0.58:
# holdout 4/4 positive, 1 false positive, FPPH 0.7685/1.3013h; vẫn là production beta.
# Chỉ đặt path khi chủ động thử artifact khác.
# VD override: LIVA_WAKE_MODEL_PATHS=models/wake_liva_en.onnx
LIVA_WAKE_MODEL_PATHS=
# Mặc định trong code và cấu hình phát hành đều là ngưỡng tối ưu của v2.
LIVA_WAKE_THRESHOLD=0.58
# Model mel-spectrogram/embedding dùng chung (bundle Apache-2.0 từ
# livekit-wakeword) — để trống = tự tìm models/wakeword_{melspec,embedding}.onnx
LIVA_WAKE_MELSPEC_PATH=
LIVA_WAKE_EMBEDDING_PATH=
# Game mode (auto | on | off): auto = phát hiện app fullscreen foreground.
# Khi vào game: (1) hạ priority tiến trình xuống BELOW_NORMAL để không giật game,
# (2) game-aware GPU downshift (xem LIVA_GAME_N_GPU_LAYERS trên). Áp dụng cho CẢ
# gateway (main.rs) LẪN desktop shell (Tauri) — mỗi tiến trình tự quản priority
# của mình; UI/overlay không bị ảnh hưởng (WebView2 render ở tiến trình con + DWM
# composite, chỉ luồng host như IPC/llama.cpp/STT/TTS nhường CPU). Governor tự
# loại cửa sổ của chính LIVA (so PID) nên overlay không bị nhận nhầm là game.
LIVA_GAME_MODE=auto
# Hạ priority CPU khi game (on | off). off = TẮT riêng phần priority nhưng vẫn
# giữ phát hiện game (GPU downshift vẫn chạy). Chỉ "off" mới tắt; giá trị khác = on.
LIVA_GAME_PRIORITY=on

# Ngưỡng tải CPU (%) coi là "máy đang bận" — nhánh phát hiện thứ HAI, độc lập với
# fullscreen. Dò fullscreen sai cả hai chiều: YouTube F11/PowerPoint bị tính là
# game, còn Blender render hay biên dịch ở cửa sổ thường thì không thấy. Chế độ
# tiết kiệm bật khi fullscreen HOẶC CPU ≥ ngưỡng này.
#
# Con số đem so là tải của TIẾN TRÌNH KHÁC — phần CPU của chính LIVA đã bị trừ,
# nếu không thì mỗi lần LLM sinh câu trả lời LIVA sẽ tự kết luận "máy bận" rồi
# hạ priority của chính mình.
#
# 0 = tắt hẳn nhánh CPU (chỉ dựa vào fullscreen). Giá trị >100 hoặc rác → mặc định 80.
# Hạ xuống ~60 nếu bạn hay chạy máy nặng và muốn LIVA nhường sớm hơn.
LIVA_BUSY_CPU_PERCENT=80

# Ngưỡng tải GPU (%) — nhánh phát hiện thứ BA (NVML, chỉ NVIDIA; máy khác thì
# nhánh này tự tắt, không ảnh hưởng gì). Bắt ca cả fullscreen lẫn CPU đều mù:
# render/encode GPU ở cửa sổ thường (Blender GPU, NVENC, training).
#
# Cùng bài học với CPU: số đem so là tải NGOÀI LIVA. Windows/WDDM thường không
# cho đọc tải GPU theo tiến trình, nên khi LIVA có thể đang dùng GPU
# (LIVA_LLM_N_GPU_LAYERS > 0) mà không tách được phần của mình, nhánh này BỎ
# tín hiệu thay vì đoán — thà mất một nhánh còn hơn tự bóp cổ chính mình.
#
# 0 = tắt hẳn nhánh GPU. Giá trị >100 hoặc rác → mặc định 80.
LIVA_BUSY_GPU_PERCENT=80

# ─── Vision (Qwen3-VL lõi hợp nhất) — lệnh vision:ask / "nhìn màn hình" ──
# LƯU Ý: đường vision CHỈ chạy ở build RELEASE (debug bung assert CRT).
# Vùng chụp cho vision: full | cursor | auto (mặc định auto).
#   auto   = crop quanh chuột khi có game fullscreen, else toàn màn hình.
#   cursor = luôn crop quanh con trỏ (nhanh ~6×, ít VRAM — Mouse-Guided).
#   full   = luôn chụp toàn màn hình.
LIVA_VISION_REGION=auto
# Kích thước ô crop quanh chuột (px, mặc định 512).
LIVA_VISION_CROP=512

# ─── 5c. Mic pre-processing / turn-taking (nghiên cứu 2026-07-04) ──
# Smart Turn + AEC vẫn TẮT mặc định. GTCRN denoise NAY BẬT MẶC ĐỊNH (khử ồn
# phím cơ/game/Discord trước VAD/STT); đặt LIVA_DENOISE_ENABLED=0 để tắt.
# Thiếu models/gtcrn_simple.onnx thì tự chạy không khử ồn (không lỗi).
# Xem docs/99-luu-tru/bao-cao-lich-su/LIVA_OSS_Research_2026-07.md để biết chi tiết + license.
# GTCRN denoise (models/gtcrn_simple.onnx, MIT) chạy trước VAD/STT.
LIVA_DENOISE_ENABLED=1
LIVA_DENOISE_MODEL_PATH=
# Smart Turn v3.2 (models/smart_turn_v3.2_cpu.onnx, BSD-2) — SHADOW MODE: chỉ
# log xác suất kết thúc lượt nói để so sánh, KHÔNG thay quyết định VAD hiện có
# (tiếng Việt là ngôn ngữ yếu nhất của model này, ~81% so với ~94% tiếng Anh).
LIVA_TURN_SHADOW_ENABLED=0
LIVA_TURN_MODEL_PATH=
# Sonora AEC3 (pure-Rust, BSD-3) — khử tiếng LIVA tự nói vọng lại mic khi
# barge-in (chưa xử lý được tiếng game qua loa, chỉ tiếng TTS của chính LIVA).
LIVA_AEC_ENABLED=0

# ─── 6. Obsidian Vault (MCP knowledge base) ─────────
LIVA_VAULT_PATH=E:\Project\LIVA\teamwork_projects\obsidian_llm_wiki\vault

# ─── 7. AI Provider Mode ────────────────────────────
# ⚠️ LÕI RUST KHÔNG ĐỌC BẤT KỲ BIẾN AI_* NÀO. Đừng trông đợi "chế độ cloud".
#    - ApiManagementView.vue đọc/ghi chúng vào .env như VĂN BẢN (qua vault);
#      không có đường nào đưa chúng vào tiến trình Rust.
#    - Nơi duy nhất thật sự tiêu thụ AI_* là scripts/ai-pre-commit.cjs:47-49
#      (git hook kiểm duyệt diff), KHÔNG phải ứng dụng LIVA.
# Model LLM của LIVA lấy từ data/liva-config.json (ai.localModelsDir +
# ai.routerModel), không lấy từ đây.
AI_PROVIDER=local
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-2.5-flash

# ─── 8. Social & Messaging Integrations ─────────────
# Telegram — CÓ THẬT, chạy khi khởi động binary liva-native-core độc lập.
# ⚠️ ALLOWED_IDS để trống nghĩa là CHO PHÉP TẤT CẢ, không phải cấm tất cả.
#    Luôn điền danh sách ID cụ thể trước khi đặt BOT_TOKEN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# ⚠️ [CHƯA IMPLEMENT] — các khoá dưới đây chỉ được ApiManagementView.vue lưu
# vào .env; KHÔNG có code nào ở backend đọc và cũng chưa có tính năng tương ứng.
# Điền vào đây không làm gì cả. Giữ lại để form UI không mất trường.
REMOTE_CONTROL_ENABLED=true
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=
# Zalo OA — [CHƯA IMPLEMENT]
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_USER_ID=

# ─── 9. Email Client (IMAP) — [CHƯA IMPLEMENT] ──────
# Không có client IMAP nào trong lõi Rust. Grep "imap" → 0 kết quả.
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASS=

# ─── 10. Tool calling & MCP server ngoài ────────────
# LLM tự chọn tool từ schema thật (cổng nghiệm thu G1). MẶC ĐỊNH TẮT —
# đặt =1 để bật.
LIVA_TOOL_CALLING=
# Danh sách server MCP ngoài cho phép truy hồi, CSV — vd "home-assistant,github".
# Không đặt thì chỉ có tool nội bộ.
LIVA_TOOL_CALLING_SERVERS=
# Tool ngoài được TỰ CHẠY sau khi LLM chọn, CSV "server/tool" hoặc "server/*".
# Mặc định mọi tool ngoài chỉ ở chế độ PROPOSE (người dùng phải xác nhận).
LIVA_MCP_AUTOEXEC=
# Đường dẫn cấu hình MCP server ngoài (mặc định: mcp_config.json cạnh binary).
LIVA_MCP_CONFIG=
# Timeout mỗi lượt gọi MCP server ngoài, ms (mặc định 15000).
LIVA_MCP_TIMEOUT_MS=

# ─── 11. Geolocation (opt-in, RA INTERNET) ──────────
# Mặc định TẮT. =1 mới cho phép tool thời tiết/định vị gọi dịch vụ mạng.
LIVA_GEOLOCATION_ENABLED=

# ─── 12. Voice pipeline & WebSocket gateway ─────────
# VAD mặc định BẬT ở cả standalone lẫn vỏ Tauri (=0 để tắt).
LIVA_VAD_ENABLED=
# Bearer token bắt buộc cho WebSocket khi gateway mở ra ngoài 127.0.0.1.
# Loopback không cần token (chỉ allow-list chat/voice/health).
LIVA_WS_AUTH_TOKEN=
# Messenger integration (Chrome CDP): cổng DevTools và timeout ms
# (mặc định 9444 / 15000).
LIVA_MESSENGER_CDP_PORT=
LIVA_MESSENGER_TIMEOUT_MS=

# ─── 13. Vị trí dữ liệu & skill cục bộ ──────────────
# Neo gốc dữ liệu người dùng (SQLite, vault, model manifest). Mặc định:
# cây nguồn → %LOCALAPPDATA%/com.liva.cognitive-os (Windows) hoặc neo tương đương.
# Hữu ích khi ổ hệ thống đầy hoặc cần chạy nhiều hồ sơ độc lập.
LIVA_HOME=
# Thư mục skill cục bộ (mặc định "skills" dưới gốc dữ liệu).
LIVA_SKILLS_DIR=
